#!/usr/bin/env bash
set -euo pipefail

fail() { printf 'rbw-env: %s\n' "$1" >&2; exit 1; }

[ "$#" -ge 1 ] || fail 'usage: rbw-env [--folder] <exact-folder> [-- <command> [args...]] | rbw-env list | rbw-env show <folder>/<KEY>'
mode=folder
case $1 in
  --folder)
    [ "$#" -ge 2 ] || fail 'folder required after --folder'
    folder=$2
    shift 2
    [ -n "$folder" ] || fail 'folder must not be empty'
    ;;
  list)
    [ "$#" -eq 1 ] || fail 'list takes no arguments'
    mode=list
    ;;
  show)
    [ "$#" -eq 2 ] || fail 'show requires exactly one selector'
    selector=$2
    case $selector in
      */*) folder=${selector%/*}; key=${selector##*/} ;;
      *) fail 'invalid selector' ;;
    esac
    [ -n "$folder" ] && [[ $key =~ ^[A-Z_][A-Z0-9_]*$ ]] || fail 'invalid selector'
    mode=show
    ;;
  __complete-show)
    if [ "${RBW_ENV_INTERNAL_COMPLETE:-}" = 1 ]; then
      [ "$#" -eq 2 ] || fail '__complete-show requires exactly one prefix'
      prefix=$2
      mode=complete
    else
      folder=$1
      shift
    fi
    ;;
  *)
    folder=$1
    shift
    [ -n "$folder" ] || fail 'folder must not be empty'
    ;;
esac

if [ -n "${HOME:-}" ]; then
  PATH=${PATH:+$PATH:}$HOME/.cargo/bin:$HOME/.local/bin
fi

run_command=false
if [ "$mode" = folder ] && [ "$#" -gt 0 ]; then
  [ "$1" = -- ] || fail 'unexpected arguments (use -- before a command)'
  shift
  [ "$#" -gt 0 ] || fail 'command required after --'
  run_command=true
fi

# shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
metadata_projection='
  def render($nodes; $parent; $indent):
    [$nodes[] | select(
      (.path | length) == (($parent | length) + 1) and
      .path[0:($parent | length)] == $parent
    )] | sort_by(.path[-1], (if .folder then 0 else 1 end)) as $children |
    $children | to_entries[] |
    . as $entry |
    ($entry.key == (($children | length) - 1)) as $last |
    $entry.value as $child |
    ($indent + (if $last then "`-- " else "|-- " end) + $child.path[-1] +
      (if $child.folder then "/" else "" end)),
    (if $child.folder then
      render($nodes; $child.path; $indent + (if $last then "    " else "|   " end))
    else empty end);
  if length != 1 then error("multiple documents") else .[0] |
    if type != "array" or any(.[];
        type != "object" or
        (.id | type != "string" or length == 0) or
        (.name | type != "string" or length == 0) or
        (.folder | type != "string" and type != "null") or
        (.type | type != "string" or length == 0) or
        ((.id + .name + (.folder // "")) | test("[\\x00\\t\\r\\n]")))
    then error("malformed list")
    elif ([.[] | .id] | group_by(.) | any(length > 1))
    then error("duplicate id")
    else [.[] | select(
      .type == "Note" and
      (.folder | type) == "string" and
      (.folder | length) > 0 and
      (.name | test("^[A-Z_][A-Z0-9_]*$"))) |
      (.folder | split("/")) as $folder |
      if any($folder[]; length == 0) then error("empty component")
      else {id, folder, name, path: ($folder + [.name])} end] as $items |
      if ([$items[].path] | group_by(.) | any(length > 1))
      then error("duplicate selector")
      else $items end
    end
  end'

if [ "$mode" = complete ]; then
  rbw=$(command -v rbw 2>/dev/null) || exit 0
  jq=$(command -v jq 2>/dev/null) || exit 0
  "$rbw" unlocked >/dev/null 2>&1 || exit 0
  list_json=$("$rbw" list --raw 2>/dev/null) || exit 0
  # Internal completion surface: validated metadata paths only; never item details or unlock.
  # shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
  printf '%s' "$list_json" | "$jq" -ser --arg prefix "$prefix" "$metadata_projection"'
    | reduce .[] as $item ([];
        . + [range(1; ($item.path | length)) as $depth |
          {candidate: (($item.path[0:$depth] | join("/")) + "/"), folder: true}]
        + [{candidate: ($item.path | join("/")), folder: false}]
      )
    | unique_by([.candidate, .folder])
    | map(select(.candidate | startswith($prefix)))
    | map(. + {rest: (.candidate | ltrimstr($prefix))})
    | map(select(
        (.rest == "" and (.folder | not)) or
        (.rest != "" and ((.rest | rtrimstr("/")) | contains("/") | not))
      ))
    | sort_by(.candidate, .folder)
    | .[].candidate
  ' 2>/dev/null || :
  exit 0
fi

command -v rbw >/dev/null 2>&1 || fail 'required command not found: rbw'
# shellcheck disable=SC2016 # Backticks are literal installation guidance.
command -v jq >/dev/null 2>&1 || fail 'required command not found: jq; install jq with your system package manager (for example, `brew install jq` on macOS), then retry'
rbw=$(command -v rbw)
jq=$(command -v jq)

pinentry=''
configured=$("$rbw" config show 2>/dev/null | "$jq" -er '.pinentry | strings | select(length > 0)' 2>/dev/null || :)
if [ -n "$configured" ]; then
  if case "$configured" in */*) [ -x "$configured" ];; *) command -v "$configured" >/dev/null 2>&1;; esac; then
    pinentry=$configured
  else
    # shellcheck disable=SC2016 # Backticks are literal remediation guidance.
    fail 'configured rbw pinentry is unusable; update it with `rbw config set pinentry <command-or-path>`'
  fi
else
  for candidate in pinentry pinentry-curses pinentry-tty pinentry-mac; do
    if command -v "$candidate" >/dev/null 2>&1; then pinentry=$candidate; break; fi
  done
fi
[ -n "$pinentry" ] || fail 'no usable pinentry found (configure rbw pinentry or install pinentry, pinentry-curses, pinentry-tty, or pinentry-mac)'

if ! "$rbw" unlocked >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # Backticks are literal user guidance.
  [ -t 0 ] || fail 'rbw is locked or unavailable; run `rbw unlock` interactively, then retry'
  "$rbw" unlock >/dev/null 2>&1 || fail 'interactive rbw unlock failed'
  "$rbw" unlocked >/dev/null 2>&1 || fail 'rbw remains locked after interactive unlock'
fi

if ! list_json=$("$rbw" list --raw 2>/dev/null); then
  fail 'could not enumerate rbw entries'
fi
if [ "$mode" = list ]; then
  # shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
  if ! tree=$(printf '%s' "$list_json" | "$jq" -ser "$metadata_projection"'
    | reduce .[] as $item ([];
      . + [range(1; ($item.path | length)) as $depth |
        {path: $item.path[0:$depth], folder: true}]
      + [{path: $item.path, folder: false}]
    ) | unique_by([.path, .folder]) as $nodes |
      ".", render($nodes; []; "")
  ' 2>/dev/null); then
    fail 'list results are malformed or ambiguous'
  fi
  printf '%s\n' "$tree"
  exit 0
fi
if [ "$mode" = show ]; then
  # shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
  if ! id=$(printf '%s' "$list_json" | "$jq" -ser --arg folder "$folder" --arg name "$key" "$metadata_projection"'
    | [.[] | select(.folder == $folder and .name == $name)] as $matches |
    if ($matches | length) != 1 then error("missing or ambiguous") else $matches[0].id end
  ' 2>/dev/null); then
    fail 'Secure Note is missing, malformed, or ambiguous'
  fi
  # shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
  if ! value=$("$rbw" get "$id" --raw 2>/dev/null | "$jq" -ser \
      --arg id "$id" --arg folder "$folder" --arg name "$key" '
        if length != 1 then error("multiple documents") else .[0] |
          select(type == "object" and .id == $id and .folder == $folder and .name == $name and
            has("data") and .data == null and (.notes | type) == "string") |
          (.notes | split("\n")[0] | rtrimstr("\r")) as $value |
          select(($value | length) > 0 and ($value | contains("\u0000") | not)) |
          $value
        end
      ' 2>/dev/null); then
    fail 'Secure Note is missing, malformed, or has an empty first line'
  fi
  printf '%s\n' "$value"
  exit 0
fi
# shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
if ! entries=$(printf '%s' "$list_json" | "$jq" -ser --arg folder "$folder" '
  if length != 1 then error("multiple documents") else .[0] |
    if type != "array" or any(.[];
        type != "object" or
        (.id | type != "string" or length == 0) or
        (.name | type != "string" or length == 0) or
        (.folder | type != "string" and type != "null") or
        (.type | type != "string" or length == 0))
    then error("malformed list")
    elif ([.[] | select(.folder == $folder)] | length) == 0
    then error("empty folder")
    elif any(.[] | select(.folder == $folder); .type != "Note")
    then error("wrong item type")
    elif ([.[] | select(.folder == $folder) | .id] | group_by(.) | any(length > 1))
    then error("duplicate id")
    else .[] | select(.folder == $folder) |
      if (.id + .name | test("[\\t\\r\\n]")) then error("unsafe metadata")
      else [.id, .name] | @tsv end
    end
  end
' 2>/dev/null); then
  fail 'folder results are malformed, empty, or ambiguous'
fi

ids=()
keys=()
values=()
while IFS=$'\t' read -r id key extra; do
  [ -n "$id" ] && [ -n "$key" ] && [ -z "${extra:-}" ] || fail 'folder results are malformed or ambiguous'
  [[ $key =~ ^[A-Z_][A-Z0-9_]*$ ]] || fail 'an item name is not a valid environment variable'
  for existing in "${keys[@]:-}"; do
    [ "$existing" != "$key" ] || fail 'duplicate environment variable name'
  done
  ids+=("$id")
  keys+=("$key")
done <<<"$entries"
[ "${#keys[@]}" -gt 0 ] || fail 'folder results are malformed or empty'

for ((i=0; i<${#keys[@]}; i++)); do
  # shellcheck disable=SC2016 # jq programs expand jq variables, not shell variables.
  if ! value=$("$rbw" get "${ids[$i]}" --raw 2>/dev/null | "$jq" -ser \
      --arg id "${ids[$i]}" --arg folder "$folder" --arg name "${keys[$i]}" '
        if length != 1 then error("multiple documents") else .[0] |
          select(type == "object" and .id == $id and .folder == $folder and .name == $name and
            has("data") and .data == null and (.notes | type) == "string") |
          (.notes | split("\n")[0] | rtrimstr("\r")) as $value |
          select(($value | length) > 0 and ($value | contains("\u0000") | not)) |
          $value
        end
      ' 2>/dev/null); then
    fail 'a Secure Note is missing, malformed, ambiguous, or has an empty first line'
  fi
  values+=("$value")
done

if $run_command; then
  for ((i=0; i<${#keys[@]}; i++)); do
    printf -v "${keys[$i]}" '%s' "${values[$i]}"
    export "${keys[$i]}"
  done
  exec "$@"
fi

for ((i=0; i<${#keys[@]}; i++)); do
  printf "%s='%s'\n" "${keys[$i]}" "${values[$i]}"
done
